{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "webdev5001",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && PORT=5001 VITE_API_BASE_URL=http://localhost:5000 npm run dev"
      ],
      "port": 5001
    },
    {
      "name": "karma-frontend",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "-f",
        "docker-compose.local.yml",
        "up",
        "frontend"
      ],
      "port": 3000
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd expo_app && npx expo start --web --port 8081"
      ],
      "port": 8081
    }
  ]
}
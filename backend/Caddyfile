{
  email {$EMAIL}
  # For first-time testing, you can use the staging CA to avoid rate-limits:
  # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# Redirect bare www -> apex (optional)
www.{$APP_HOST} {
  redir https://{$APP_HOST}{uri}
}

# Primary site
{$APP_HOST} {
  # The in-app assistant service. Its answers stream as text/event-stream,
  # which reverse_proxy flushes as they arrive; it gets its own `handle` so
  # gzip (below) never sits in front of the stream.
  handle /assistant/* {
    reverse_proxy assistant:5077
  }

  handle {
    encode gzip
    reverse_proxy web:5000
  }

  # (Optional) Security headers:
  # header {
  #   Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  #   X-Content-Type-Options "nosniff"
  #   X-Frame-Options "DENY"
  #   Referrer-Policy "strict-origin-when-cross-origin"
  # }
}
